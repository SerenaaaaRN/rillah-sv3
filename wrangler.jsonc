{
	"name": "rillah-sv3",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"preview_urls": false,
	"vars": {},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"invocation_logs": true
		}
	}
}
